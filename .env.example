# Variables de entorno para producción
# Copiar este archivo como .env.local y configurar con tus valores reales

# Supabase (opcional)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Contraseña maestra del sistema (reemplazar por una más segura)
NEXT_PUBLIC_MASTER_PASSWORD=fuxion2025!

# Configuración de deployment
NEXT_PUBLIC_APP_NAME="Inventario Fuxion Casa"
NEXT_PUBLIC_APP_VERSION="1.0.0"
